{
  "name": "fourchette-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "all": "node scripts/node-check.cjs && node scripts/all.ts",
    "preflight": "node scripts/node-check.cjs && node scripts/preflight.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "verify": "npm run typecheck && npm test",
    "acceptance": "node scripts/acceptance.ts",
    "acceptance:fetch": "node scripts/fetch-acceptance.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "hono": "^4.13.18"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
